# 复制本文件为 .env 并填入你自己的值（.env 已被 gitignore，不会上传）
# Windows 提示：用记事本编辑后请"另存为→编码选 UTF-8"，值两边不要加引号、不要留空格

# 必填：智谱开放平台 https://open.bigmodel.cn/ 注册后在"API密钥"页领取
ZHIPU_API_KEY=在这里粘贴你的密钥

# 可选：大模型（默认 glm-4.7-flash 免费模型；深度推理可设 LLM_THINKING=1）
# ZHIPU_MODEL=glm-4.7-flash
# LLM_THINKING=0

# 可选：后端端口（默认 8001；与失物招领系统同机部署时勿改回 8000）
# SERVER_PORT=8001

# 可选：管线开关（默认全开；消融实验/答辩对比时用）
# RAG_QUERY_REWRITE=1
# RAG_HYBRID=1
# RAG_RERANK=1
# USE_VECTOR_RETRIEVAL=0   # 关闭后仅走 BM25 关键词检索（v3.3）

# 可选：质量自评 Critic（v3.3）：重排分数在灰区时评估资料是否足够，
# 不足自动换写法重检索（最多3轮），高分快速通过不加延迟
# RAG_CRITIC=1
# CRITIC_MAX_ITER=3
# CRITIC_SCORE_HIGH=0.75

# 可选：GPU 加速（v3.3，需 CUDA 版 torch）：默认自动探测，
# 空闲显存 > GPU_MIN_FREE_MB 就把向量+重排模型放上显卡，爆显存自动回退 CPU；
# 设 EMBEDDING_DEVICE=cpu 可强制纯 CPU
# GPU_MIN_FREE_MB=1536
# EMBEDDING_DEVICE=cpu

# 可选：思考模式分级开关（glm-4.7 混合思考模型，v3.3）
# LLM_REWRITE_THINKING=0   # 查询改写：默认关（改写在你等待的关键路径上）
# LLM_CRITIC_THINKING=1    # 质量自评：默认开（精度收益最大）
# LLM_THINKING=0           # 最终答案生成：默认关
# LLM_TIMEOUT=30           # 普通调用超时秒数
# LLM_THINKING_TIMEOUT=60  # 开思考的调用超时秒数（思考本身要 10~30 秒）

# 可选：换更强的重排模型（CPU 推理约慢 3 倍，rerank_score_threshold 需重调）
# RERANK_MODEL=bge-reranker-v2-m3

# 企业化改造：复制 backend/config/domain_profiles/valorant.yaml 后设置
# APP_DOMAIN=enterprise
