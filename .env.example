# 复制本文件为 .env 并填入你自己的值（.env 已被 gitignore，不会上传）
# Windows 提示：用记事本编辑后请"另存为→编码选 UTF-8"，值两边不要加引号、不要留空格

# 必填：智谱开放平台 https://open.bigmodel.cn/ 注册后在"API密钥"页领取
ZHIPU_API_KEY=在这里粘贴你的密钥

# 可选：大模型（默认 glm-4.7-flash 免费模型；深度推理可设 LLM_THINKING=1）
# ZHIPU_MODEL=glm-4.7-flash
# LLM_THINKING=0

# 可选：后端端口（默认 8001；与失物招领系统同机部署时勿改回 8000）
# SERVER_PORT=8001

# 可选：管线开关（默认全开；消融实验/答辩对比时用）
# RAG_QUERY_REWRITE=1
# RAG_HYBRID=1
# RAG_RERANK=1
# USE_VECTOR_RETRIEVAL=0   # 关闭后仅走 BM25 关键词检索（v3.3）

# 可选：质量自评 Critic（v3.3）：重排分数在灰区时评估资料是否足够，
# 不足自动换写法重检索，高分快速通过不加延迟
# RAG_CRITIC=1
# CRITIC_MAX_ROUNDS=1   # v3.11 默认 1（速度优先）；追求质量可调 3（质量优先）
# CRITIC_SCORE_HIGH=0.75

# 可选：GPU 加速（v3.3，需 CUDA 版 torch）：默认自动探测，
# 空闲显存 > GPU_MIN_FREE_MB 就把向量+重排模型放上显卡，爆显存自动回退 CPU；
# 设 EMBEDDING_DEVICE=cpu 可强制纯 CPU
# GPU_MIN_FREE_MB=1536
# EMBEDDING_DEVICE=cpu

# 可选：思考模式分级开关（glm-4.7 混合思考模型，v3.3）
# LLM_REWRITE_THINKING=1   # 查询改写：默认开（多轮指代消解精度优先；在意延迟可设 0）
# LLM_CRITIC_THINKING=0    # 质量自评：默认关（Layer3 标注集 A/B 实测思考零增益）
# LLM_THINKING=0           # 最终答案生成：默认关
# LLM_TIMEOUT=30           # 普通调用超时秒数
# LLM_THINKING_TIMEOUT=60  # 开思考的调用超时秒数（思考本身要 10~30 秒）
# LLM_MAX_RETRIES=1        # openai 客户端自动重试次数（v3.11 默认 1，失败快速反馈）

# 可选：限流兜底模型（v3.18）：主模型限流/过载时自动切换（同账号同密钥，只换模型名），
# 默认 glm-4-flashx（智谱最便宜付费款，约 0.1 元/百万tokens 级，以官网为准）——
# 兜底只在限流时触发，日常花费趋近于零；审计日志以 +fallback 标记；设空串关闭兜底
# LLM_FALLBACK_MODEL=glm-4-flashx

# 可选：主模型切付费通道（2026-09-24 同卷实测：免费档晚高峰 miss P50 70.7s → 付费 5.7s；
# 语义缓存命中 P50 ≈ 10ms）。付费为主、免费降为兜底的完整切法：
# ZHIPU_MODEL=glm-4-flashx
# LLM_FALLBACK_MODEL=glm-4.7-flash
# LLM_REWRITE_THINKING=0     # flashx 非混合思考系列，改写思考一并关闭

# 可选：语义缓存（v3.19）：相似问题命中直接复用答案（毫秒级返回），
# 只缓存带来源的成功回答；知识库上传/删除/重建索引自动失效；审计以 +cache_hit 标记
# RAG_SEMANTIC_CACHE=1
# RAG_CACHE_THRESHOLD=0.92     # 余弦相似度阈值，宁漏勿错；误命中就调高
# RAG_CACHE_TTL_MINUTES=1440   # 条目有效期（默认 24 小时）
# RAG_CACHE_MAX=512            # 每知识库最大条数（FIFO 淘汰）

# 可选：换更强的重排模型（CPU 推理约慢 3 倍，rerank_score_threshold 需重调）
# RERANK_MODEL=bge-reranker-v2-m3

# 可选：API Key 认证（v3.20）：默认关；开了以后所有 /api 接口要求请求头 X-API-Key
# AUTH_ENABLED=1
# API_KEYS=key1,key2          # 多个 key 用英文逗号分隔
# APP_ENV=development         # 设为 production 时强制开启认证（fail-closed），
#                             # 即使忘了设 AUTH_ENABLED=1 也不会裸奔；
#                             # 认证开启但 API_KEYS 没配 → 所有请求 401（宁全拒不裸奔）

# 企业化改造：复制 backend/config/domain_profiles/valorant.yaml 后设置
# APP_DOMAIN=enterprise

# 可选：成本防护（v3.24，付费通道必开）：输入限长 + IP 双层限流，防脚本刷问答烧 token
# MAX_QUESTION_CHARS=300        # 单次提问最大字符数（服务层软上限，另有 1000 字模型层硬兜底）
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_CHAT_PER_MIN=5    # 每分钟提问上限（按真实 IP）
# RATE_LIMIT_CHAT_DAILY=100    # 每日提问上限（按真实 IP；≈0.035 元/天的 token 上限）
